{
  "name": "deckbuilder-giubravo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:art-hash-index": "node scripts/build-art-hash-index.mjs",
    "build:monolith": "node scripts/build-monolith.mjs",
    "build:all": "npm run build && npm run build:monolith",
    "loc:write-index": "node scripts/write-loc-into-index.mjs --write",
    "test": "node --check src/main.js && node scripts/catalog-cache-spec.mjs && node scripts/card-text-cache-spec.mjs && node scripts/ocr-card-features-spec.mjs && node scripts/ocr-diag-analyze-spec.mjs && node scripts/art-hash-spec.mjs && npm run build --silent && npm run build:monolith --silent",
    "vendor:ygo-deck-icons": "node scripts/vendor-ygo-deck-icons.mjs",
    "vendor:ocr-models": "node scripts/vendor-ocr-models.mjs",
    "vendor:tess-lang": "node scripts/vendor-tess-lang.mjs",
    "benchmark:passcode-offline": "node scripts/bench-passcode-offline.mjs",
    "benchmark:name-offline": "node scripts/bench-name-offline.mjs",
    "format": "prettier -w index.html src/main.js src/style.css vite.config.js",
    "doc:refresh-index-ids": "node scripts/generate-index-html-id-catalog-comment.mjs --write",
    "benchmark:update": "node scripts/benchmark-update.mjs",
    "benchmark:compare": "node scripts/bench-compare.mjs",
    "benchmark:baseline": "node scripts/build-scanner-benchmark-baseline.mjs"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "sharp": "^0.34.2",
    "tesseract.js": "^4.1.4",
    "tesseract.js-core": "^4.0.1",
    "vite": "^7.1.3"
  },
  "dependencies": {
    "esearch-ocr": "^8.5.0",
    "fflate": "^0.8.3",
    "onnxruntime-web": "^1.22.0"
  }
}
